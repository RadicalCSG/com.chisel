{
    "name": "com.chisel.core.tests",
    "rootNamespace": "Chisel.Core.Tests",
    "references": [
        "UnityEngine.TestRunner",
        "UnityEditor.TestRunner",
        "com.chisel.core",
        "AssetMetadataRuntime",
        "com.chisel.dots.extensions",
        "Unity.Burst",
        "Unity.Collections",
        "Unity.Entities",
        "Unity.Mathematics",
        "Unity.Mathematics.Extensions"
    ],
    "includePlatforms": [
        "Editor"
    ],
    "excludePlatforms": [],
    "allowUnsafeCode": true,
    "overrideReferences": true,
    "precompiledReferences": [
        "nunit.framework.dll"
    ],
    "autoReferenced": false,
    "defineConstraints": [
        "UNITY_INCLUDE_TESTS",
        "CHISEL_ASSET_METADATA"
    ],
    "versionDefines": [
        {
            "name": "com.custom_asset_metadata",
            "expression": "0.0.0",
            "define": "CHISEL_ASSET_METADATA"
        }
    ],
    "noEngineReferences": false
}
